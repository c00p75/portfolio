# ---------------------------------------------------------------------------
# Generation for the /sandbox retrieval demo.
# Providers are tried in the order below (see src/lib/rag/generate.ts): the
# first with a key serves the request, and the next takes over if it fails.
# With none of them set the sandbox still runs — retrieval executes and cited
# passages are shown, with an explicit notice that generation is unavailable.
# ---------------------------------------------------------------------------

# Free tier, fastest. The default answer path.
GROQ_API_KEY=

# Free tier. First fallback.
GEMINI_API_KEY=

# Metered. Second fallback, so it only bills when both free tiers are down.
OPENAI_API_KEY=

# Metered, best citation discipline. Last in the chain.
ANTHROPIC_API_KEY=

# Optional. Overrides the Anthropic model only. Defaults to claude-opus-5.
# ANSWER_MODEL=claude-opus-5

# ---------------------------------------------------------------------------
# Embeddings for `npm run ingest`. Anthropic has no embeddings endpoint, so this
# is a second provider by necessity — isolated in src/lib/rag/embed.ts.
# Without it, ingest builds a LEXICAL-ONLY index: BM25 retrieval works, but
# paraphrased questions do worse. The site says so rather than hiding it.
# ---------------------------------------------------------------------------
VOYAGE_API_KEY=

# Optional. Raises the GitHub API rate limit when `npm run ingest` refreshes
# the public-profile snapshot. Without it the unauthenticated quota is enough.
# GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Signing key for replayed assistant turns (src/lib/rag/history.ts).
# The chat transcript lives in the browser and is replayed on every request, so
# the server signs each answer it produces and only replays back the assistant
# turns whose signature verifies. Without that, a caller can forge what the
# assistant "already said" and read the safety rules in the system prompt in a
# context the server never produced.
#
# Optional. Unset, the secret is derived from whichever provider key is already
# configured, which is stable across instances. With no keys at all it falls
# back to a per-process random value, in which case assistant turns simply stop
# verifying across instances and are dropped: the conversation gets shorter
# memory, never a weaker check. Set it explicitly if you rotate provider keys
# and do not want in-flight conversations to lose continuity.
# ---------------------------------------------------------------------------
ASK_HISTORY_SECRET=

# ---------------------------------------------------------------------------
# Rate limiting for /api/ask (src/lib/rag/ratelimit.ts).
# Optional, but the cap is only real with it: without a shared store the
# counter lives in each serverless instance, so the effective ceiling is
# `limit × instances` and a cold start resets it. Since the cap bounds token
# spend on a public endpoint, set this in production.
# Upstash (https://upstash.com) free tier is enough. Vercel KV works too — it
# speaks the same REST protocol, and its KV_REST_API_* variables are read as a
# fallback, so on Vercel you may not need to set anything by hand.
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Contact form delivery (src/app/api/contact/route.ts), sent through Resend —
# the same provider and DKIM'd domain the BalloAds backend sends from.
# Without RESEND_API_KEY and CONTACT_FROM the form falls back to a mailto link
# rather than accepting messages it would silently drop.
#
# CONTACT_FROM must be a verified sender on a domain with Resend DKIM set up,
# in "Name <address@domain>" form. The visitor's address goes in reply_to, so
# hitting reply in the mail client answers them rather than the sender domain.
# CONTACT_TO defaults to the address in src/lib/site.ts.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
CONTACT_FROM="Portfolio <noreply@balloads.com>"
# CONTACT_TO=

# ---------------------------------------------------------------------------
# The previous portfolio (the `main` branch), which is its own deployment but
# is proxied onto this domain at /v1 by the rewrite in next.config.mjs.
#
# V1_ORIGIN is that deployment's own URL. Unset, the rewrite is not installed
# and /v1 404s rather than proxying to a host that isn't there — so set it in
# production. It must be the deployment's direct URL, never this domain, or the
# rewrite loops back on itself.
# ---------------------------------------------------------------------------
V1_ORIGIN=

# Optional. Where the footer's V2/V1 switch points. Defaults to /v1, matching
# the rewrite above; set it to a full URL to send visitors to a subdomain
# instead.
# NEXT_PUBLIC_V1_URL=https://v1.georgemsapenda.dev
