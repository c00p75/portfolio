# ---------------------------------------------------------------------------
# Generation for the /sandbox retrieval demo.
# Without this the sandbox still runs: retrieval executes and cited passages are
# shown, with an explicit notice that generation is unavailable.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5.
# ANSWER_MODEL=claude-opus-5

# ---------------------------------------------------------------------------
# Embeddings for `npm run ingest`. Anthropic has no embeddings endpoint, so this
# is a second provider by necessity — isolated in src/lib/rag/embed.ts.
# Without it, ingest builds a LEXICAL-ONLY index: BM25 retrieval works, but
# paraphrased questions do worse. The site says so rather than hiding it.
# ---------------------------------------------------------------------------
VOYAGE_API_KEY=

# ---------------------------------------------------------------------------
# Contact form. Without it the contact page falls back to a mailto link rather
# than showing a form that silently discards messages.
# https://formspree.io — create a form, paste its ID.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FORMSPREE_ID=
